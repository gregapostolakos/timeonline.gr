<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>WordPress Password Bridge</name>
	<code>wp_password_bridge</code>
	<version>1.0</version>
	<author>timeonline.gr</author>
	<link></link>

	<!--
		Lets customers migrated from the WooCommerce store sign in with the
		password they already have. The stored WordPress hash is verified by
		Cart\WpPassword (system/library/cart/wppassword.php) and replaced with
		an OpenCart hash on the first successful login.
	-->

	<file path="system/library/cart/customer.php">
		<operation>
			<search><![CDATA[AND (password = SHA1(CONCAT(salt,]]></search>
			<add position="after"><![CDATA[
			if (!$customer_query->num_rows) {
				$wp_customer_query = WpPassword::migrate($this->db, $email, $password);

				if ($wp_customer_query) {
					$customer_query = $wp_customer_query;
				}
			}
]]></add>
		</operation>
	</file>

	<!-- Storefront: change password + password reset. -->
	<file path="catalog/model/account/customer.php">
		<operation>
			<search><![CDATA[public function editPassword($email, $password) {]]></search>
			<add position="after"><![CDATA[
		\Cart\WpPassword::forgetByEmail($this->db, $email);
]]></add>
		</operation>
	</file>

	<!-- Admin: password set from Customers -> Edit. -->
	<file path="admin/model/customer/customer.php">
		<operation>
			<search><![CDATA[if ($data['password']) {]]></search>
			<add position="after"><![CDATA[
			\Cart\WpPassword::forget($this->db, $customer_id);
]]></add>
		</operation>
	</file>
</modification>
