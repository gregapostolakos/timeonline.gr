{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-bulk-special" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
          <i class="fa fa-save"></i>
        </button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
          <i class="fa fa-reply"></i>
        </a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <ul class="nav nav-tabs">
          <li class="active">
            <a href="#tab-general" data-toggle="tab">{{ tab_general }}</a>
          </li>
          <li>
            <a href="#tab-products" data-toggle="tab">{{ tab_products }}</a>
          </li>
          <li>
            <a href="#tab-exclude" data-toggle="tab">{{ tab_exclude }}</a>
          </li>
        </ul>
        <form action="{{ action }}" method="post" id="form-bulk-special" class="form-horizontal">
          <div class="tab-content">
            <div class="tab-pane active" id="tab-general">
                {% if bulk_special_id %}
                    <input type="hidden" name="bulk_special_id" value="{{ bulk_special_id }}" />
                {% endif %}
                <div class="form-group required">
                    <label class="col-sm-2 control-label">{{ entry_name }}</label>
                    <div class="col-sm-10">
                    <input type="text" name="name" value="{{ name }}" class="form-control" />
                    </div>
                </div>
                <div class="form-group required">
                <label class="col-sm-2 control-label">{{ entry_customer_group }}</label>
                <div class="col-sm-10">
                    <div class="well well-sm" style="height: 150px; overflow: auto;">
                    {% for customer_group in customer_groups %}
                        <div class="checkbox">
                        <label>
                            <input
                            type="checkbox"
                            name="customer_group_ids[]"
                            value="{{ customer_group.customer_group_id }}"
                            {% if customer_group.customer_group_id in customer_group_ids %}checked{% endif %}
                            />
                            {{ customer_group.name }}
                        </label>
                        </div>
                    {% endfor %}
                    </div>
                </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_priority }}</label>
                    <div class="col-sm-10">
                        <input type="number" name="priority" value="{{ priority }}" class="form-control" placeholder="1"/>
                    </div>
                </div>
              <div class="form-group required">
                <label class="col-sm-2 control-label">{{ entry_discount }}</label>
                <div class="col-sm-10">
                  <input type="number" step="0.01" name="discount_percent" value="{{ discount_percent }}" class="form-control" />
                </div>
              </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_date_start }}</label>
                    <div class="col-sm-10">
                        <div class="input-group date">
                        <input type="text" name="date_start" value="{{ date_start }}" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" class="form-control"/>
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                        </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label">{{ entry_date_end }}</label>
                    <div class="col-sm-10">
                        <div class="input-group date">
                        <input type="text" name="date_end" value="{{ date_end }}" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" class="form-control"/>
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                        </span>
                        </div>
                    </div>
                </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="status" class="form-control">
                    <option value="1" {{ status ? 'selected' }}>{{ text_enabled }}</option>
                    <option value="0" {{ not status ? 'selected' }}>{{ text_disabled }}</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-products">
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-category">
                    <span data-toggle="tooltip" title="{{ help_category }}">{{ entry_categories }}</span>
                    </label>
                    <div class="col-sm-10">
                    <input type="text" name="category" value="" placeholder="{{ entry_categories }}" id="input-category" class="form-control"/>
                    <div id="bulk-special-category" class="well well-sm" style="height: 150px; overflow: auto;">
                        {% if categories %}
                        {% for category in categories %}
                            <div id="bulk-special-category{{ category.category_id }}">
                            <i class="fa fa-minus-circle"></i> {{ category.name }}
                            <input type="hidden" name="category_ids[]" value="{{ category.category_id }}"/>
                            </div>
                        {% endfor %}
                        {% endif %}
                    </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-manufacturer">
                    {{ entry_manufacturers }}
                    </label>
                    <div class="col-sm-10">
                    <input type="text" name="manufacturer" value="" placeholder="{{ entry_manufacturers }}" id="input-manufacturer" class="form-control"/>
                    <div id="bulk-special-manufacturer" class="well well-sm" style="height: 150px; overflow: auto;">
                        {% if manufacturers %}
                        {% for manufacturer in manufacturers %}
                            <div id="bulk-special-manufacturer{{ manufacturer.manufacturer_id }}">
                            <i class="fa fa-minus-circle"></i> {{ manufacturer.name }}
                            <input type="hidden" name="manufacturer_ids[]" value="{{ manufacturer.manufacturer_id }}"/>
                            </div>
                        {% endfor %}
                        {% endif %}
                    </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-product">
                    {{ entry_products }}
                    </label>
                    <div class="col-sm-10">
                        <input type="text" name="product" value="" placeholder="{{ entry_products }}" id="input-product" class="form-control"/>
                        <div id="bulk-special-product" class="well well-sm" style="height: 150px; overflow: auto;">
                            {% if products %}
                                {% for product in products %}
                                    <div id="bulk-special-product{{ product.product_id }}">
                                    <i class="fa fa-minus-circle"></i> {{ product.name }}
                                    <input type="hidden" name="product_ids[]" value="{{ product.product_id }}"/>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane" id="tab-exclude">
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-ex-category">
                    <span data-toggle="tooltip" title="{{ help_category }}">{{ entry_categories }}</span>
                    </label>
                    <div class="col-sm-10">
                    <input type="text" name="ex_category" value="" placeholder="{{ entry_categories }}" id="input-ex-category" class="form-control"/>
                    <div id="bulk-special-ex-category" class="well well-sm" style="height: 150px; overflow: auto;">
                        {% if ex_categories %}
                        {% for category in ex_categories %}
                            <div id="bulk-special-ex-category{{ category.category_id }}">
                            <i class="fa fa-minus-circle"></i> {{ category.name }}
                            <input type="hidden" name="ex_category_ids[]" value="{{ category.category_id }}"/>
                            </div>
                        {% endfor %}
                        {% endif %}
                    </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-ex-manufacturer">
                    {{ entry_manufacturers }}
                    </label>
                    <div class="col-sm-10">
                    <input type="text" name="ex_manufacturer" value="" placeholder="{{ entry_manufacturers }}" id="input-ex-manufacturer" class="form-control"/>
                    <div id="bulk-special-ex-manufacturer" class="well well-sm" style="height: 150px; overflow: auto;">
                        {% if ex_manufacturers %}
                        {% for manufacturer in ex_manufacturers %}
                            <div id="bulk-special-ex-manufacturer{{ manufacturer.manufacturer_id }}">
                            <i class="fa fa-minus-circle"></i> {{ manufacturer.name }}
                            <input type="hidden" name="ex_manufacturer_ids[]" value="{{ manufacturer.manufacturer_id }}"/>
                            </div>
                        {% endfor %}
                        {% endif %}
                    </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-ex-product">
                    {{ entry_products }}
                    </label>
                    <div class="col-sm-10">
                        <input type="text" name="ex_product" value="" placeholder="{{ entry_products }}" id="input-ex-product" class="form-control"/>
                        <div id="bulk-special-ex-product" class="well well-sm" style="height: 150px; overflow: auto;">
                            {% if ex_products %}
                                {% for product in ex_products %}
                                    <div id="bulk-special-ex_product{{ product.product_id }}">
                                    <i class="fa fa-minus-circle"></i> {{ product.name }}
                                    <input type="hidden" name="ex_product_ids[]" value="{{ product.product_id }}"/>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">

    // Categories
    $('input[name=\'category\']').autocomplete({
      'source': function(request, response) {
          $.ajax({
          url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
          dataType: 'json',
          success: function(json) {
              response($.map(json, function(item) {
              return {
                  label: item['name'],
                  value: item['category_id']
              }
              }));
          }
          });
      },
      'select': function(item) {
          $('input[name=\'category\']').val('');

          $('#bulk-special-category' + item['value']).remove();

          $('#bulk-special-category').append(
          '<div id="bulk-special-category' + item['value'] + '">' +
          '<i class="fa fa-minus-circle"></i> ' + item['label'] +
          '<input type="hidden" name="category_ids[]" value="' + item['value'] + '" />' +
          '</div>'
          );
      }
    });

    $('#bulk-special-ex-category').delegate('.fa-minus-circle', 'click', function() {
      $(this).parent().remove();
    });

    $('input[name=\'ex_category\']').autocomplete({
      'source': function(request, response) {
          $.ajax({
          url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
          dataType: 'json',
          success: function(json) {
              response($.map(json, function(item) {
              return {
                  label: item['name'],
                  value: item['category_id']
              }
              }));
          }
          });
      },
      'select': function(item) {
          $('input[name=\'ex_category\']').val('');

          $('#bulk-special-ex-category' + item['value']).remove();

          $('#bulk-special-ex-category').append(
          '<div id="bulk-special-ex-category' + item['value'] + '">' +
          '<i class="fa fa-minus-circle"></i> ' + item['label'] +
          '<input type="hidden" name="ex_category_ids[]" value="' + item['value'] + '" />' +
          '</div>'
          );
      }
    });

    $('#bulk-special-ex-category').delegate('.fa-minus-circle', 'click', function() {
      $(this).parent().remove();
    });

    // Manufacturer
    $('input[name=\'manufacturer\']').autocomplete({
    'source': function(request, response) {
        $.ajax({
        url: 'index.php?route=catalog/manufacturer/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
            response($.map(json, function(item) {
            return {
                label: item['name'],
                value: item['manufacturer_id']
            }
            }));
        }
        });
    },
    'select': function(item) {
        $('input[name=\'manufacturer\']').val('');

        $('#bulk-special-manufacturer' + item['value']).remove();

        $('#bulk-special-manufacturer').append(
        '<div id="bulk-special-manufacturer' + item['value'] + '">' +
        '<i class="fa fa-minus-circle"></i> ' + item['label'] +
        '<input type="hidden" name="manufacturer_ids[]" value="' + item['value'] + '" />' +
        '</div>'
        );
    }
    });

    $('#bulk-special-manufacturer').delegate('.fa-minus-circle', 'click', function() {
      $(this).parent().remove();
    });

    $('input[name=\'ex_manufacturer\']').autocomplete({
    'source': function(request, response) {
        $.ajax({
        url: 'index.php?route=catalog/manufacturer/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
            response($.map(json, function(item) {
            return {
                label: item['name'],
                value: item['manufacturer_id']
            }
            }));
        }
        });
    },
    'select': function(item) {
        $('input[name=\'ex_manufacturer\']').val('');

        $('#bulk-special-ex-manufacturer' + item['value']).remove();

        $('#bulk-special-ex-manufacturer').append(
        '<div id="bulk-special-ex-manufacturer' + item['value'] + '">' +
        '<i class="fa fa-minus-circle"></i> ' + item['label'] +
        '<input type="hidden" name="ex_manufacturer_ids[]" value="' + item['value'] + '" />' +
        '</div>'
        );
    }
    });

    $('#bulk-special-ex-manufacturer').delegate('.fa-minus-circle', 'click', function() {
      $(this).parent().remove();
    });


    // Product
    $('input[name=\'product\']').autocomplete({
    'source': function(request, response) {
        $.ajax({
        url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
            response($.map(json, function(item) {
            return {
                label: item['name'],
                value: item['product_id']
            }
            }));
        }
        });
    },
    'select': function(item) {
        $('input[name=\'product\']').val('');

        $('#bulk-special-product' + item['value']).remove();

        $('#bulk-special-product').append(
        '<div id="bulk-special-product' + item['value'] + '">' +
        '<i class="fa fa-minus-circle"></i> ' + item['label'] +
        '<input type="hidden" name="product_ids[]" value="' + item['value'] + '" />' +
        '</div>'
        );
    }
    });

    $('#bulk-special-product').delegate('.fa-minus-circle', 'click', function() {
      $(this).parent().remove();
    });

    $('input[name=\'ex_product\']').autocomplete({
      'source': function(request, response) {
          $.ajax({
          url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
          dataType: 'json',
          success: function(json) {
              response($.map(json, function(item) {
              return {
                  label: item['name'],
                  value: item['product_id']
              }
              }));
          }
          });
      },
      'select': function(item) {
          $('input[name=\'ex_product\']').val('');

          $('#bulk-special-ex-product' + item['value']).remove();

          $('#bulk-special-ex-product').append(
          '<div id="bulk-special-ex-product' + item['value'] + '">' +
          '<i class="fa fa-minus-circle"></i> ' + item['label'] +
          '<input type="hidden" name="ex_product_ids[]" value="' + item['value'] + '" />' +
          '</div>'
          );
      }
    });

    $('#bulk-special-ex-product').delegate('.fa-minus-circle', 'click', function() {
      $(this).parent().remove();
    });
</script>

<script type="text/javascript">
    $('.date').datetimepicker({
        pickTime: false
    });
</script>

{{ footer }}
