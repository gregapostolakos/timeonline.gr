</style>

<script type="text/javascript"><!--
var TXT = { percent: '{{ text_percent }}', fixed: '{{ text_fixed }}' };
var RULE_TYPES = {{ rule_types|json_encode|raw }};
var LABEL_INDEXES = {{ label_indexes|json_encode|raw }};

function bufferRow(btype, id, name) {
  if ($('#buffer-' + btype + '-' + id).length) return;
  var html = '<tr id="buffer-' + btype + '-' + id + '">'
    + '<td>' + name + '<input type="hidden" name="buffer_' + btype + '_id[]" value="' + id + '"/></td>'
    + '<td><select name="buffer_' + btype + '_op[]" class="was-select"><option value="percent">' + TXT.percent + '</option><option value="fixed">' + TXT.fixed + '</option></select></td>'
    + '<td><input type="text" name="buffer_' + btype + '_val[]" value="0" class="was-input"/></td>'
    + '<td style="text-align:right"><button type="button" class="was-btn was-btn-danger was-btn-icon buffer-remove"><i class="fa fa-minus"></i></button></td></tr>';
  $('#buffer-' + btype + '-body').append(html);
}

// --- custom-label rules: add / remove rows + type-aware autocomplete ---
var RULE_AC_URL = 'index.php?route=extension/feed/webartstudio_google/autocomplete&user_token={{ user_token }}';

// Show the reference (category/manufacturer) or amount cell depending on type.
function ruleApplyType($tr) {
  var t = $tr.find('.rule-type').val();
  var isRef = (t === 'category' || t === 'manufacturer');
  var isNum = (t === 'price_min' || t === 'price_max');
  $tr.find('.rule-ref-search').toggle(isRef);
  $tr.find('.rule-ref-cell .rule-na').toggle(!isRef);
  $tr.find('.rule-num').toggle(isNum);
  $tr.find('.rule-num-cell .rule-na').toggle(!isNum);
}

function bindRule($tr) {
  var $type   = $tr.find('.rule-type');
  var $search = $tr.find('.rule-ref-search');
  var $ref    = $tr.find('.rule-ref');

  $type.on('change', function() { ruleApplyType($tr); $search.val(''); $ref.val(''); });
  ruleApplyType($tr);

  $search.autocomplete({
    'source': function(request, response) {
      var t = $type.val();
      if (t !== 'category' && t !== 'manufacturer') { response([]); return; }
      $.ajax({
        url: RULE_AC_URL + '&type=' + t + '&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) { return { label: item.name, value: item.reference_id }; }));
        }
      });
    },
    'select': function(item) {
      $search.val(item.label);
      $ref.val(item.value);
    }
  });
}

function labelRuleRow() {
  var labelOpts = '';
  LABEL_INDEXES.forEach(function(i) { labelOpts += '<option value="' + i + '">Label ' + i + '</option>'; });
  var typeOpts = '';
  RULE_TYPES.forEach(function(t) { typeOpts += '<option value="' + t + '">' + t + '</option>'; });
  var html = '<tr>'
    + '<td><select name="label_rule_label[]" class="was-select">' + labelOpts + '</select></td>'
    + '<td><select name="label_rule_type[]" class="was-select rule-type">' + typeOpts + '</select></td>'
    + '<td class="rule-ref-cell"><input type="text" class="was-input rule-ref-search" value="" placeholder="{{ text_autocomplete }}" autocomplete="off"/><input type="hidden" name="label_rule_ref[]" class="rule-ref" value=""/><span class="rule-na">—</span></td>'
    + '<td class="rule-num-cell"><input type="text" name="label_rule_num[]" class="was-input rule-num" value="" placeholder="0.00"/><span class="rule-na">—</span></td>'
    + '<td><input type="text" name="label_rule_output[]" value="" placeholder="{{ text_label_value }}" class="was-input"/></td>'
    + '<td style="text-align:right"><button type="button" class="was-btn was-btn-danger was-btn-icon label-rule-remove"><i class="fa fa-minus"></i></button></td></tr>';
  var $tr = $(html);
  $('#label-rules-body').append($tr);
  bindRule($tr);
}
$('#add-label-rule').on('click', labelRuleRow);
$('#label-rules-body').on('click', '.label-rule-remove', function() { $(this).closest('tr').remove(); });

// Bind autocomplete + type toggle on any rules restored from settings.
$('#label-rules-body tr').each(function() { bindRule($(this)); });

// --- exclude products: autocomplete + add/remove pills ---
$('input[name=\'autocomplete_product\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=extension/feed/webartstudio_google/autocomplete&user_token={{ user_token }}&type=product&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) { return { label: item.name, value: item.reference_id }; }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'autocomplete_product\']').val('');
    if ($('#exclude-product-' + item.value).length) return;
    $('#exclude-product').append('<div id="exclude-product-' + item.value + '" class="was-listitem"><i class="fa fa-minus-circle"></i> ' + item.label
      + '<input type="hidden" name="exclude_product[]" value="' + item.value + '"/></div>');
  }
});
$('#exclude-product').on('click', '.fa-minus-circle', function() { $(this).parent().remove(); });

// --- exclude categories / manufacturers: full checkbox lists ---
var categoryChildren = {};
$('#exclude-category-list [data-category-id]').each(function() {
  var id = parseInt($(this).data('category-id'));
  var parentId = parseInt($(this).data('parent-id'));
  if (parentId > 0) {
    (categoryChildren[parentId] = categoryChildren[parentId] || []).push(id);
  }
});
function categoryDescendants(id) {
  var out = [], kids = categoryChildren[id] || [];
  for (var i = 0; i < kids.length; i++) { out.push(kids[i]); out = out.concat(categoryDescendants(kids[i])); }
  return out;
}
function highlightRow($row, $list) {
  if (!$row.length) return;
  $row.addClass('was-hit');
  setTimeout(function() { $row.removeClass('was-hit'); }, 800);
  $list.scrollTop($list.scrollTop() + $row.position().top - 20);
}

$('#exclude-category-list').on('change', 'input[type="checkbox"]', function() {
  if ($(this).prop('checked')) {
    var id = parseInt($(this).closest('[data-category-id]').data('category-id'));
    categoryDescendants(id).forEach(function(d) {
      $('#exclude-category-list [data-category-id="' + d + '"] input[type="checkbox"]').prop('checked', true);
    });
  }
});

function listAutocomplete(inputName, type, listId, attr, withChildren) {
  $('input[name=\'' + inputName + '\']').autocomplete({
    'source': function(request, response) {
      $.ajax({
        url: 'index.php?route=extension/feed/webartstudio_google/autocomplete&user_token={{ user_token }}&type=' + type + '&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) { return { label: item.name, value: item.reference_id }; }));
        }
      });
    },
    'select': function(item) {
      $('input[name=\'' + inputName + '\']').val('');
      var $list = $('#' + listId);
      var $row = $list.find('[' + attr + '="' + item.value + '"]');
      var ids = [parseInt(item.value)];
      if (withChildren) ids = ids.concat(categoryDescendants(parseInt(item.value)));
      ids.forEach(function(d) { $list.find('[' + attr + '="' + d + '"] input[type="checkbox"]').prop('checked', true); });
      highlightRow($row, $list);
    }
  });
}
listAutocomplete('autocomplete_category', 'category', 'exclude-category-list', 'data-category-id', true);
listAutocomplete('autocomplete_manufacturer', 'manufacturer', 'exclude-manufacturer-list', 'data-manufacturer-id', false);

$('#check-all-categories').on('click', function() { $('#exclude-category-list input[type=checkbox]').prop('checked', true); });
$('#uncheck-all-categories').on('click', function() { $('#exclude-category-list input[type=checkbox]').prop('checked', false); });
$('#check-all-manufacturers').on('click', function() { $('#exclude-manufacturer-list input[type=checkbox]').prop('checked', true); });
$('#uncheck-all-manufacturers').on('click', function() { $('#exclude-manufacturer-list input[type=checkbox]').prop('checked', false); });

['product', 'category', 'manufacturer'].forEach(function(type) {
  $('input[name=\'autocomplete_buffer_' + type + '\']').autocomplete({
    'source': function(request, response) {
      $.ajax({
        url: 'index.php?route=extension/feed/webartstudio_google/autocomplete&user_token={{ user_token }}&type=' + type + '&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) { return { label: item.name, value: item.reference_id }; }));
        }
      });
    },
    'select': function(item) {
      $('input[name=\'autocomplete_buffer_' + type + '\']').val('');
      bufferRow(type, item.value, item.label);
    }
  });
});

$('#tab-buffer').on('click', '.buffer-remove', function() {
  $(this).closest('tr').remove();
});
//--></script>
{{ footer }}
