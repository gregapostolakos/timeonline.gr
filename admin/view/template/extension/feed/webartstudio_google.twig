.was-ui .was-tagbox{display:flex;flex-wrap:wrap;gap:8px}
.was-ui .was-check{display:inline-flex;align-items:center;gap:8px;margin:0;padding:9px 14px;border:1px solid var(--was-border);border-radius:var(--was-radius-md);background:var(--was-surface);font-size:13px;font-weight:600;color:var(--was-text-muted);cursor:pointer;transition:all .15s var(--was-ease)}
.was-ui .was-check:hover{border-color:rgba(43,38,32,.20)}
.was-ui .was-check input{accent-color:var(--was-primary);margin:0}
.was-ui .was-check:has(input:checked){background:var(--was-primary-soft);border-color:var(--was-primary);color:var(--was-primary)}
.was-ui .was-checklist{margin-top:10px;max-height:300px;overflow:auto;border:1px solid var(--was-border);border-radius:var(--was-radius-md);background:var(--was-surface);padding:6px}
.was-ui .was-checkrow{display:flex;align-items:center;gap:9px;margin:0;padding:7px 10px;border-radius:var(--was-radius-sm);font-size:13px;font-weight:500;color:var(--was-text);cursor:pointer;transition:background .4s var(--was-ease)}
.was-ui .was-checkrow:hover{background:var(--was-surface-hover)}
.was-ui .was-checkrow input{accent-color:var(--was-primary);margin:0}
.was-ui .was-checkrow.was-hit{background:var(--was-warning-soft)}
.was-ui .was-btn-sm{height:32px;padding:0 12px;font-size:12.5px}
/* custom-label rules table */
.was-ui #label-rules-body td{vertical-align:middle}
