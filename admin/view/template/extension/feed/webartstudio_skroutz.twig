// --- exclude categories / manufacturers: full checkbox lists ---

// Build parent→children map for categories (descendant auto-check)
var categoryChildren = {};
$('#exclude-category-list [data-category-id]').each(function() {
  var id = parseInt($(this).data('category-id'));
  var parentId = parseInt($(this).data('parent-id'));
  if (parentId > 0) {
    (categoryChildren[parentId] = categoryChildren[parentId] || []).push(id);
  }
});
function categoryDescendants(id) {
  var out = [], kids = categoryChildren[id] || [];
  for (var i = 0; i < kids.length; i++) { out.push(kids[i]); out = out.concat(categoryDescendants(kids[i])); }
  return out;
}
function highlightRow($row, $list) {
  if (!$row.length) return;
  $row.addClass('was-hit');
  setTimeout(function() { $row.removeClass('was-hit'); }, 800);
  $list.scrollTop($list.scrollTop() + $row.position().top - 20);
}

// Checking a category also checks all its descendants
$('#exclude-category-list').on('change', 'input[type="checkbox"]', function() {
  if ($(this).prop('checked')) {
    var id = parseInt($(this).closest('[data-category-id]').data('category-id'));
    categoryDescendants(id).forEach(function(d) {
      $('#exclude-category-list [data-category-id="' + d + '"] input[type="checkbox"]').prop('checked', true);
    });
  }
});

// Generic list autocomplete: tick the matching checkbox + scroll into view
function listAutocomplete(inputName, type, listId, attr, withChildren) {
  $('input[name=\'' + inputName + '\']').autocomplete({
    'source': function(request, response) {
      $.ajax({
        url: 'index.php?route=extension/feed/webartstudio_skroutz/autocomplete&user_token={{ user_token }}&type=' + type + '&filter_name=' + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) { return { label: item.name, value: item.reference_id }; }));
        }
      });
    },
    'select': function(item) {
      $('input[name=\'' + inputName + '\']').val('');
      var $list = $('#' + listId);
      var $row = $list.find('[' + attr + '="' + item.value + '"]');
      var ids = [parseInt(item.value)];
      if (withChildren) ids = ids.concat(categoryDescendants(parseInt(item.value)));
      ids.forEach(function(d) { $list.find('[' + attr + '="' + d + '"] input[type="checkbox"]').prop('checked', true); });
      highlightRow($row, $list);
    }
  });
}
listAutocomplete('autocomplete_category', 'category', 'exclude-category-list', 'data-category-id', true);
listAutocomplete('autocomplete_manufacturer', 'manufacturer', 'exclude-manufacturer-list', 'data-manufacturer-id', false);

